    },
    "The %@ this account's CLI uses. A new folder is created; pick an existing one if you already sign in there.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %@ this account's CLI uses. A new folder is created; pick an existing one if you already sign in there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hesabın CLI’sinin kullandığı %@. Yeni bir klasör oluşturulur; orada zaten oturum açtıysanız mevcut bir klasör seçin."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這個帳號的 CLI 所用的 %@。會建立新的資料夾；若你已在某個資料夾登入，請選擇它。"
          }
        }
      }
    },
    "The Mac was asleep too long past the scheduled time to catch up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac was asleep too long past the scheduled time to catch up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac, planlanan zamandan sonra yetişmek için çok uzun süre uykuda kaldı."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 睡眠超過排定時間太久，無法補上。"
          }
        }
      }
    },
    "The folder must be an absolute path without quotes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder must be an absolute path without quotes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör, tırnak içermeyen mutlak bir yol olmalıdır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資料夾必須是不含引號的絕對路徑。"
          }
        }
      }
    },
    "The highest weekly quota use among your accounts, from each one's latest reading. Weekly quotas reset once a week.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The highest weekly quota use among your accounts, from each one's latest reading. Weekly quotas reset once a week."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesaplarınız arasında en yüksek haftalık kota kullanımı; her birinin son okumasından. Haftalık kotalar haftada bir sıfırlanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依各帳號最新的讀數，你所有帳號中最高的每週額度用量。每週額度每週重置一次。"
          }
        }
      }
    },
    "The last warm-up failed, so retries are delayed to avoid hammering the provider.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last warm-up failed, so retries are delayed to avoid hammering the provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son ısıtma başarısız oldu; bu yüzden sağlayıcıyı zorlamamak için yeniden denemeler ertelenir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次預熱失敗，因此延後重試，以免頻繁打擾服務商。"
          }
        }
      }
    },
    "The latest quota check wasn't healthy, so a fresh window can't be confirmed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest quota check wasn't healthy, so a fresh window can't be confirmed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kota kontrolü sağlıklı değildi; bu yüzden yeni bir pencere doğrulanamıyor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最新的額度檢查不正常，因此無法確認新的時段。"
          }
        }
      }
    },
    "The morning pre-warm will open the next window at %@.": {
      "localizations": {
