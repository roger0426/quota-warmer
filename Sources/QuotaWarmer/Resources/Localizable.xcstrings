        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planlanan uyandırma atlandı (pildeydi). Mac uyandığı için kota pencereniz şimdi ısıtılıyor."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排定的喚醒被略過（使用電池中）。Mac 已喚醒，正在預熱你的額度時段。"
          }
