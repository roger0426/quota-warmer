    "Scheduled for %@, but on battery with the lid closed the wake may be skipped — your window warms the moment you open the lid.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled for %@, but on battery with the lid closed the wake may be skipped — your window warms the moment you open the lid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için planlandı; ancak pilde ve kapak kapalıyken uyandırma atlanabilir — kapağı açtığınız anda pencereniz ısınır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排定於 %@，但使用電池且闔上螢幕時可能不會喚醒——打開螢幕的那一刻就會預熱你的時段。"
          }
        }
      }
    },
    "Scheduled for %@; battery and a closed lid can prevent the wake.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled for %@; battery and a closed lid can prevent the wake."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ için planlandı; pil ve kapalı kapak uyandırmayı engelleyebilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排定於 %@；使用電池或闔上螢幕可能使喚醒失效。"
          }
        }
      }
    },
    "Schedules your Mac to wake before your day starts and opens a fresh window. Turning it on shows one macOS administrator prompt (pmset needs root). Only applies to tools set to Auto-warm.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules your Mac to wake before your day starts and opens a fresh window. Turning it on shows one macOS administrator prompt (pmset needs root). Only applies to tools set to Auto-warm."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizi gününüz başlamadan uyandırır ve yeni bir pencere açar. Açmak, bir macOS yönetici istemi gösterir (pmset kök yetkisi gerektirir). Yalnızca Otomatik ısıtma’ya alınmış araçlar için geçerlidir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排定 Mac 在你一天開始前喚醒，並開啟新的時段。開啟時會出現一次 macOS 管理者提示（pmset 需要 root）。只套用於設為「自動預熱」的工具。"
          }
        }
      }
    },
    "Segment": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Segment"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bölüm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "區段"
          }
        }
      }
    },
    "Send a warm-up message to %@ now? It uses a small amount of quota.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send a warm-up message to %@ now? It uses a small amount of quota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabına şimdi bir ısıtma mesajı gönderilsin mi? Az miktarda kota kullanır."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在要送出預熱訊息給 %@ 嗎？這會用掉少量額度。"
          }
        }
      }
    },
    "Sends the minimal warm-up message to start a fresh quota window now. Asks for confirmation first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the minimal warm-up message to start a fresh quota window now. Asks for confirmation first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir kota penceresini şimdi başlatmak için minimal ısıtma mesajını gönderir. Önce onay ister."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即送出最簡短的預熱訊息以開始新的額度時段。會先要求確認。"
          }
        }
      }
    },
