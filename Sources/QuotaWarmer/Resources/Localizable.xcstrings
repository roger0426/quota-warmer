    "30 minutes left in your 5h quota window. QuotaWarmer will auto-trigger at reset.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 minutes left in your 5h quota window. QuotaWarmer will auto-trigger at reset."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saatlik kota penceresinde 30 dakika kaldı. QuotaWarmer sıfırlanmada otomatik olarak tetiklenecek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 小時額度時段剩 30 分鐘。重置時 QuotaWarmer 會自動觸發。"
          }
        }
      }
    },
