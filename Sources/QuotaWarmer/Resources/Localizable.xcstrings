    "Share of observed 5-hour windows whose peak use reached 80%. Low means quota went unused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share of observed 5-hour windows whose peak use reached 80%. Low means quota went unused."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zirve kullanımı %80’e ulaşan gözlemlenen 5 saatlik pencerelerin oranı. Düşük, kotanın kullanılmadan kaldığı anlamına gelir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在觀察到的 5 小時時段中，高峰用量達到 80% 的比例。偏低表示額度沒用完。"
          }
        }
      }
    },
