    " Each account is a segment of the bar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Each account is a segment of the bar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Her hesap çubukta ayrı bir bölüm olarak gösterilir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 每個帳號是長條中的一段。"
          }
        }
      }
    },
    " Orange is Claude and blue is Codex; a square used by both (neither above 80% of its tokens) is purple.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Orange is Claude and blue is Codex; a square used by both (neither above 80% of its tokens) is purple."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Turuncu Claude, mavi Codex’tir; ikisinin de kullandığı (hiçbirinin token’larının %80’ini aşmadığı) kare mor renktedir."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 橘色是 Claude、藍色是 Codex；兩者都用到（且都未超過自身 token 的 80%）的格子為紫色。"
          }
        }
      }
    },
    " across all accounts": {
      "localizations": {
        "en": {
