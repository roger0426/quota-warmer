    "5-hour quota window is now active. Next auto-trigger in 5 hours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5-hour quota window is now active. Next auto-trigger in 5 hours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saatlik kota penceresi artık etkin. Bir sonraki otomatik tetikleme 5 saat sonra."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "5 小時額度時段已啟動。下次自動觸發在 5 小時後。"
          }
        }
      }
    },
    "5-hour windows QuotaWarmer opened for you and the live quota confirmed. Missed or failed warm-ups are not counted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "5-hour windows QuotaWarmer opened for you and the live quota confirmed. Missed or failed warm-ups are not counted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer’ın sizin için açtığı ve canlı kotanın doğruladığı 5 saatlik pencereler. Kaçırılan veya başarısız ısıtmalar sayılmaz."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer 為你開啟、且經即時額度確認的 5 小時時段。未送出或失敗的預熱不計入。"
          }
        }
      }
    },
